<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Vai Márcia</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- Modo de áudio em segundo plano: permite que um áudio termine de tocar (Cenário A, AVAudioPlayer)
         mesmo se a tela travar no meio de um toque durante a partida. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <key>WKBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!-- A gravação acontece no celular, não no relógio, então NSMicrophoneUsageDescription
         é propositalmente não declarada aqui. -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Vai Márcia usa Bluetooth para tocar áudios direto na sua caixa de som ou avisar seu celular.</string>

    <key>WKApplication</key>
    <true/>
    <key>WKWatchKitApp</key>
    <true/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
