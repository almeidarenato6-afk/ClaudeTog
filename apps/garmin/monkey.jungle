# Connect IQ build config. Build with the Connect IQ SDK's `monkeyc` compiler, e.g.:
#   monkeyc -f monkey.jungle -d fenix7 -o bin/VaiMarcia.prg -y developer_key.der

project.manifest = manifest.xml

base.sourcePath = source
base.resourcePath = resources

# Realistic device-specific resource overrides would go here as devices are added, e.g.:
# fenix7.resourcePath = resources-round-260x260
# venu2.resourcePath = resources-round-390x390
