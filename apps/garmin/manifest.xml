<?xml version="1.0" encoding="UTF-8"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="a1b2c3d4-e5f6-4a1b-8c3d-vaimarciagrm1"
        type="watch-app"
        name="@Strings.AppName"
        entry="VaiMarciaApp"
        launcherIcon="@Drawables.LauncherIcon"
        minSdkVersion="4.2.0">

        <!-- Communications: o canal de comando RELAY para o celular (Communications.transmit).
             Os dispositivos Garmin, na maioria, não conseguem reproduzir áudio arbitrário de
             terceiros (veja README.md e garmin_capability_table.json), então este app opera em
             modo RELAY por padrão. -->
        <iq:permissions>
            <iq:uses-permission id="Communications" />
        </iq:permissions>

        <!-- Subconjunto realista de dispositivos compatíveis com Connect IQ que possuem suporte
             a Bluetooth + app companion. Expanda via garmin_capability_table.json ao adicionar
             um dispositivo. -->
        <iq:products>
            <iq:product id="fenix7" />
            <iq:product id="fenix7s" />
            <iq:product id="fenix7x" />
            <iq:product id="fenix8" />
            <iq:product id="venu2" />
            <iq:product id="venu2s" />
            <iq:product id="venu3" />
            <iq:product id="forerunner955" />
            <iq:product id="forerunner965" />
            <iq:product id="vivoactive5" />
            <iq:product id="epix2" />
        </iq:products>

        <iq:languages>
            <iq:language>por</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:barrels />
    </iq:application>
</iq:manifest>
