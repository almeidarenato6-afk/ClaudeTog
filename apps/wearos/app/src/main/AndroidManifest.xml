<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Companion (phone) app required for first-run pairing + catalog sync, but the watch
         app is fully usable standalone once content is cached (Scenario A on capable hardware). -->
    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" tools:node="remove" />

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Data Layer API (MessageClient/DataClient/CapabilityClient) does not require a
         separate manifest permission beyond play-services-wearable + Google Play services. -->

    <application
        android:name=".VaiMarciaWearApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- standalone="false": the watch app declares a companion phone app is expected
             (catalog sync, first-run pairing metadata), but playback itself works without
             the phone reachable in DIRECT mode once audio is cached locally. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives DataLayer messages (catalog sync pushes) even when the activity
             is not foregrounded, so cache stays warm ahead of the next tap. -->
        <service
            android:name=".data.companion.WearCompanionListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/vaimarcia"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
