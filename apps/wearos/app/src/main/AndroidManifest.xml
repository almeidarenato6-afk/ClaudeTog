<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- O app companion (celular) é necessário para o pareamento inicial + sincronização do catálogo, mas o app
         do relógio é totalmente utilizável de forma independente assim que o conteúdo está em cache (Cenário A em hardware compatível). -->
    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" tools:node="remove" />

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- A Data Layer API (MessageClient/DataClient/CapabilityClient) não exige uma
         permissão separada no manifest além do play-services-wearable + Google Play services. -->

    <application
        android:name=".VaiMarciaWearApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- standalone="false": o app do relógio declara que um app companion no celular é esperado
             (sincronização do catálogo, metadados de pareamento inicial), mas a reprodução em si funciona sem
             o celular acessível no modo DIRECT assim que o áudio está em cache localmente. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recebe mensagens da DataLayer (envios de sincronização do catálogo) mesmo quando a activity
             não está em primeiro plano, para manter o cache atualizado antes do próximo toque. -->
        <service
            android:name=".data.companion.WearCompanionListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/vaimarcia"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
