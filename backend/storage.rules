rules_version = '2';

// Vai Márcia (TogPlay) — Cloud Storage security rules.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRole(roles) {
      return isSignedIn() && request.auth.token.role in roles;
    }

    function isContentManager() {
      return hasRole(['admin', 'content_manager']);
    }

    function isAudioFile() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*');
    }

    function underSize(maxBytes) {
      return request.resource.size < maxBytes;
    }

    // -----------------------------------------------------------------
    // Catalog audio (masters + per-platform compressed variants).
    // Public read (served straight to app/watch clients), admin/
    // content_manager write only. 20 MB cap comfortably covers a
    // compressed short voice clip while blocking abuse.
    // -----------------------------------------------------------------
    match /catalog/audios/{audioId}/{fileName} {
      allow read: if true;
      allow write: if isContentManager() && isAudioFile() && underSize(20 * 1024 * 1024);
    }

    // Category icons / promotion images / any other catalog artwork.
    match /catalog/images/{allPaths=**} {
      allow read: if true;
      allow write: if isContentManager() && isImageFile() && underSize(5 * 1024 * 1024);
    }

    // -----------------------------------------------------------------
    // User-generated recordings — private by default, owner-only.
    // 25 MB cap allows a generous raw recording before future
    // AI processing (see domain/Recording.ts) compresses it down.
    // -----------------------------------------------------------------
    match /users/{uid}/recordings/{fileName} {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid) && isAudioFile() && underSize(25 * 1024 * 1024);
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
