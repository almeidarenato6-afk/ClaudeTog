rules_version = '2';

// Vai Márcia (TogPlay) — regras de segurança do Cloud Storage.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRole(roles) {
      return isSignedIn() && request.auth.token.role in roles;
    }

    function isContentManager() {
      return hasRole(['admin', 'content_manager']);
    }

    function isAudioFile() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*');
    }

    function underSize(maxBytes) {
      return request.resource.size < maxBytes;
    }

    // -----------------------------------------------------------------
    // Áudio do catálogo (masters + variantes comprimidas por plataforma).
    // Leitura pública (servida direto para os clientes app/watch), escrita
    // apenas para admin/content_manager. O limite de 20 MB cobre
    // confortavelmente um clipe de voz curto comprimido enquanto bloqueia abuso.
    // -----------------------------------------------------------------
    match /catalog/audios/{audioId}/{fileName} {
      allow read: if true;
      allow write: if isContentManager() && isAudioFile() && underSize(20 * 1024 * 1024);
    }

    // Ícones de categoria / imagens de promoção / qualquer outra arte do catálogo.
    match /catalog/images/{allPaths=**} {
      allow read: if true;
      allow write: if isContentManager() && isImageFile() && underSize(5 * 1024 * 1024);
    }

    // -----------------------------------------------------------------
    // Gravações geradas pelo usuário — privadas por padrão, apenas do dono.
    // O limite de 25 MB permite uma gravação bruta generosa antes que um
    // futuro processamento com IA (veja domain/Recording.ts) a comprima.
    // -----------------------------------------------------------------
    match /users/{uid}/recordings/{fileName} {
      allow read, delete: if isOwner(uid);
      allow write: if isOwner(uid) && isAudioFile() && underSize(25 * 1024 * 1024);
    }

    // Nega tudo mais por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
