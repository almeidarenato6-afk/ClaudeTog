rules_version = '2';

// Vai Márcia (TogPlay) — regras de segurança do Firestore.
//
// Os papéis são transportados exclusivamente como custom claims do Firebase Auth (`role`),
// nunca espelhados no documento `users/{uid}` — espelhar isso permitiria que um usuário
// autenticado se tornasse admin apenas escrevendo no próprio documento de perfil. Custom
// claims só podem ser definidas por Cloud Functions usando o Admin SDK (veja
// functions/src/api/admin/auth.ts).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRole(roles) {
      return isSignedIn() && request.auth.token.role in roles;
    }

    function isContentManager() {
      return hasRole(['admin', 'content_manager']);
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    // ---------------------------------------------------------------------
    // Catálogo — leitura pública, escrita restrita a admin/content_manager.
    // ---------------------------------------------------------------------

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isContentManager();
    }

    match /audios/{audioId} {
      allow read: if true;
      allow write: if isContentManager();
    }

    // ---------------------------------------------------------------------
    // Usuários — cada usuário é dono exatamente da própria subárvore.
    // ---------------------------------------------------------------------

    match /users/{uid} {
      // O documento de perfil nunca carrega `role`; os clientes não conseguem escrever
      // esse campo no Firestore porque ele simplesmente não faz parte deste schema
      // (veja o tipo UserProfile).
      allow read, update: if isOwner(uid);
      // A criação normalmente é feita no servidor pelo trigger de auth onUserCreate;
      // este fallback permite que o cliente crie o próprio documento caso o trigger
      // ainda não tenha rodado (ex.: a primeira leitura chega antes do trigger).
      allow create: if isOwner(uid);
      allow delete: if false;

      match /favorites/{audioId} {
        // Escritas diretas do cliente (veja api/client/favorites.ts para o motivo do design).
        allow read, write: if isOwner(uid);
      }

      match /devices/{deviceId} {
        // Escrito apenas via o callable registerDevice (o Admin SDK ignora as regras)
        // para que os campos de device/analytics sejam sempre validados no servidor.
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /recordings/{recordingId} {
        // Privado por padrão — nunca exposto a outro usuário ou ao catálogo público.
        allow read, write: if isOwner(uid);
      }
    }

    // ---------------------------------------------------------------------
    // Analytics — somente escrita a partir de Cloud Functions, nunca direto dos clientes.
    // ---------------------------------------------------------------------

    match /analytics_events/{eventId} {
      allow read, write: if false;
    }

    match /analytics_daily/{date} {
      // Os agregados alimentam o dashboard admin; usuários comuns do app nunca leem isso.
      allow read: if hasRole(['admin', 'content_manager', 'viewer']);
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Promotions — leitura pública (banners da loja), escrita restrita a admin.
    // ---------------------------------------------------------------------

    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Log de envio de notificações — apenas histórico do painel admin.
    // ---------------------------------------------------------------------

    match /notifications_log/{notificationId} {
      allow read: if hasRole(['admin', 'content_manager', 'viewer']);
      allow write: if false;
    }
  }
}
