# Firebase Web SDK config for the "Vai Márcia" project.
# TODO(backend team): replace every value below with the real config once
# the Firebase project is provisioned (Firebase Console > Project settings >
# General > Your apps > Web app). Copy this file to `.env.local` (gitignored).

VITE_FIREBASE_API_KEY=TODO
VITE_FIREBASE_AUTH_DOMAIN=TODO.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=TODO
VITE_FIREBASE_STORAGE_BUCKET=TODO.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=TODO
VITE_FIREBASE_APP_ID=TODO

# Optional: only set if the backend deploys callable functions to a
# non-default region (Cloud Functions default is us-central1).
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Optional: point the SDKs at the local Firebase Emulator Suite during
# development. Leave unset ("false") to talk to the real project.
VITE_USE_FIREBASE_EMULATORS=false
