# ============================================================================
# racket-image-agent - variaveis de ambiente
# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA faça commit do arquivo ".env" preenchido nem de chaves JSON reais.
# ============================================================================

# --- Autenticacao Google (obrigatorio: uma das duas opcoes abaixo) --------
# Opcao A) conteudo JSON da credencial (service account OU OAuth "authorized
#           user") em uma unica linha. Use em ambientes gerenciados (Cloud
#           Run, GitHub Actions) via secret manager.
GOOGLE_CREDENTIALS_JSON=

# Opcao B) caminho para um arquivo de credenciais no disco. Use em execucao
#           local ou cron Linux. Ignorado se GOOGLE_CREDENTIALS_JSON estiver
#           definido.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# --- Estrutura do Google Drive ---------------------------------------------
# ID da pasta raiz da estrutura oficial do Drive onde o agente deve localizar
# a pasta "Fotos E-commerce".
GOOGLE_DRIVE_ROOT_FOLDER_ID=REPLACE_WITH_ROOT_FOLDER_ID

# Opcional: se ja souber o ID exato da pasta "Fotos E-commerce", informe aqui
# para pular a busca por nome (mais rapido e mais robusto a renomeacoes).
FOTOS_ECOMMERCE_FOLDER_ID=

# Nome exato da pasta de destino dentro da estrutura do Drive.
FOTOS_ECOMMERCE_FOLDER_NAME=Fotos E-commerce

# Opcional: pasta onde os relatorios (JSON/CSV/MD) devem ser enviados no
# Drive, alem de serem salvos localmente. Se vazio, os relatorios ficam
# apenas no sistema de arquivos local (REPORTS_DIR).
AGENT_REPORTS_FOLDER_ID=

# --- Google Sheets (catalogo de raquetes) -----------------------------------
CATALOG_SPREADSHEET_ID=REPLACE_WITH_SPREADSHEET_ID
CATALOG_RANGE=Catalogo!A2:F

# --- Fuso horario ------------------------------------------------------------
TIMEZONE=America/Sao_Paulo

# --- Regras de imagem ---------------------------------------------------------
MIN_IMAGE_SIDE=1000
PREFERRED_IMAGE_SIDE=1500
MAX_IMAGES_PER_PRODUCT=5

# Limiar minimo (0-1) de confianca de correspondencia produto x imagem.
# Abaixo disso o item fica com status REVISAO e nao ha upload automatico.
MATCH_CONFIDENCE_THRESHOLD=0.72

# Distancia maxima (Hamming, 0-64) do perceptual hash para considerar duas
# imagens como duplicatas visuais.
PHASH_DISTANCE_THRESHOLD=6

# --- Rede / scraping ----------------------------------------------------------
HTTP_MIN_INTERVAL_SECONDS=2.0
HTTP_TIMEOUT_SECONDS=15.0
HTTP_MAX_RETRIES=3
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=300.0

# --- Persistencia local (cache/estado e relatorios) ---------------------------
STATE_FILE_PATH=data/state.json
REPORTS_DIR=data/relatorios

# --- Execucao ------------------------------------------------------------------
# true = nao cria pastas nem envia arquivos; apenas pesquisa, valida e reporta.
DRY_RUN=true
LOG_LEVEL=INFO
